# =================================================================
# SECSCAN AI - Environment Configuration
# =================================================================
#
# IMPORTANT:
# - Copy this file to .env: `cp .env.example .env`
# - Never commit your real .env file or API keys to version control.
# - The server will automatically load .env on startup.
# =================================================================

# Nebius Token Factory API Key (Required for live AI inference)
# Obtain from: https://tokenfactory.nebius.ai/ or https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory Base URL
# Default: https://api.tokenfactory.nebius.ai/v1
# Alternative Studio Endpoint: https://api.studio.nebius.ai/v1
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1

# NVIDIA Open-Source Model Identifier on Nebius Token Factory
# Recommended: nvidia/llama-3.1-nemotron-70b-instruct
# Alternative: nvidia/Llama-3.1-Nemotron-70B-Instruct-HF or nvidia/nemotron-4-340b-instruct
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Server Logging Level (trace, debug, info, warn, error)
RUST_LOG=info
